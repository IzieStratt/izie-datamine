{
  // Static files for sdmp.izie.top (Slack datamine) and vs.izie.top/redocumented (ReDocumented).
  // Not reachable on its own: the main site worker (IzieStratt/personal-site) fetches from it through a service binding.
  "name": "izie-datamine",
  "main": "./worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./website/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
